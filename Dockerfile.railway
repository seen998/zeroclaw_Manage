# ZeroClaw Railway Deployment

# Stage 1: Build Web UI
FROM node:22-alpine AS web-builder
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install --ignore-scripts
COPY web/ .
RUN npm run build

# Stage 2: Build Rust Binary
FROM rust:1.94-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy manifests
COPY Cargo.toml Cargo.lock ./
COPY src/ src/
COPY crates/zeroclaw-api/ crates/zeroclaw-api/
COPY crates/zeroclaw-config/ crates/zeroclaw-config/
COPY crates/zeroclaw-providers/ crates/zeroclaw-providers/
COPY crates/zeroclaw-memory/ crates/zeroclaw-memory/
COPY crates/zeroclaw-runtime/ crates/zeroclaw-runtime/
COPY crates/zeroclaw-tools/ crates/zeroclaw-tools/
COPY crates/zeroclaw-channels/ crates/zeroclaw-channels/
COPY crates/zeroclaw-infra/ crates/zeroclaw-infra/
COPY crates/zeroclaw-gateway/ crates/zeroclaw-gateway/
COPY crates/zeroclaw-macros/ crates/zeroclaw-macros/
COPY crates/zeroclaw-tool-call-parser/ crates/zeroclaw-tool-call-parser/
COPY crates/aardvark-sys/ crates/aardvark-sys/

# Create stub crates for optional dependencies (they're referenced in workspace but not needed for minimal build)
RUN mkdir -p crates/robot-kit/src && \
    echo "[package]" > crates/robot-kit/Cargo.toml && \
    echo 'name = "zeroclaw-robot-kit"' >> crates/robot-kit/Cargo.toml && \
    echo 'version = "0.1.0"' >> crates/robot-kit/Cargo.toml && \
    echo 'edition = "2024"' >> crates/robot-kit/Cargo.toml && \
    echo '[[bin]]' >> crates/robot-kit/Cargo.toml && \
    echo 'name = "robot-kit"' >> crates/robot-kit/Cargo.toml && \
    echo 'path = "src/main.rs"' >> crates/robot-kit/Cargo.toml && \
    echo "fn main() {}" > crates/robot-kit/src/main.rs

RUN mkdir -p crates/zeroclaw-tui/src && \
    echo "[package]" > crates/zeroclaw-tui/Cargo.toml && \
    echo 'name = "zeroclaw-tui"' >> crates/zeroclaw-tui/Cargo.toml && \
    echo 'version = "0.6.9"' >> crates/zeroclaw-tui/Cargo.toml && \
    echo 'edition = "2024"' >> crates/zeroclaw-tui/Cargo.toml && \
    echo '[[bin]]' >> crates/zeroclaw-tui/Cargo.toml && \
    echo 'name = "zeroclaw-tui"' >> crates/zeroclaw-tui/Cargo.toml && \
    echo 'path = "src/main.rs"' >> crates/zeroclaw-tui/Cargo.toml && \
    echo "fn main() {}" > crates/zeroclaw-tui/src/main.rs

RUN mkdir -p crates/zeroclaw-plugins/src && \
    echo "[package]" > crates/zeroclaw-plugins/Cargo.toml && \
    echo 'name = "zeroclaw-plugins"' >> crates/zeroclaw-plugins/Cargo.toml && \
    echo 'version = "0.6.9"' >> crates/zeroclaw-plugins/Cargo.toml && \
    echo 'edition = "2024"' >> crates/zeroclaw-plugins/Cargo.toml && \
    echo '[[bin]]' >> crates/zeroclaw-plugins/Cargo.toml && \
    echo 'name = "zeroclaw-plugins"' >> crates/zeroclaw-plugins/Cargo.toml && \
    echo 'path = "src/main.rs"' >> crates/zeroclaw-plugins/Cargo.toml && \
    echo "fn main() {}" > crates/zeroclaw-plugins/src/main.rs

RUN mkdir -p crates/zeroclaw-hardware/src && \
    echo "[package]" > crates/zeroclaw-hardware/Cargo.toml && \
    echo 'name = "zeroclaw-hardware"' >> crates/zeroclaw-hardware/Cargo.toml && \
    echo 'version = "0.6.9"' >> crates/zeroclaw-hardware/Cargo.toml && \
    echo 'edition = "2024"' >> crates/zeroclaw-hardware/Cargo.toml && \
    echo '[[bin]]' >> crates/zeroclaw-hardware/Cargo.toml && \
    echo 'name = "zeroclaw-hardware"' >> crates/zeroclaw-hardware/Cargo.toml && \
    echo 'path = "src/main.rs"' >> crates/zeroclaw-hardware/Cargo.toml && \
    echo "fn main() {}" > crates/zeroclaw-hardware/src/main.rs

# Build only zeroclawlabs with agent-runtime (includes telegram)
RUN cargo build --release --locked -p zeroclawlabs --no-default-features --features "agent-runtime"

# Create runtime directory and config
RUN mkdir -p /zeroclaw-data/.zeroclaw /zeroclaw-data/workspace /zeroclaw-data/web/dist
RUN printf '%s\n' \
    'workspace_dir = "/zeroclaw-data/workspace"' \
    'config_path = "/zeroclaw-data/.zeroclaw/config.toml"' \
    'default_provider = "openrouter"' \
    'default_model = "anthropic/claude-sonnet-4-20250514"' \
    'default_temperature = 0.7' \
    '' \
    '[gateway]' \
    'port = 42617' \
    'host = "[::]"' \
    'allow_public_bind = true' \
    'require_pairing = false' \
    'web_dist_dir = "/zeroclaw-data/web/dist"' \
    > /zeroclaw-data/.zeroclaw/config.toml

# Stage 3: Runtime
FROM gcr.io/distroless/cc-debian13:nonroot

COPY --from=builder /build/target/release/zeroclaw /usr/local/bin/zeroclaw
COPY --from=builder /zeroclaw-data /zeroclaw-data
COPY --from=web-builder /web/dist /zeroclaw-data/web/dist

ENV LANG=C.UTF-8
ENV ZEROCLAW_WORKSPACE=/zeroclaw-data/workspace
ENV HOME=/zeroclaw-data
ENV PORT=42617
ENV ZEROCLAW_ALLOW_PUBLIC_BIND=true

WORKDIR /zeroclaw-data
USER nonroot
EXPOSE 42617

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
    CMD ["/usr/local/bin/zeroclaw", "status", "--format=exit-code"]

ENTRYPOINT ["/usr/local/bin/zeroclaw"]
CMD ["daemon"]
